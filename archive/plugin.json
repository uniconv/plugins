{
  "name": "archive",
  "scope": "uniconv",
  "version": "1.0.22",
  "description": "Archive format conversion (zip, tar, gz, bz2, xz, 7z)",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "zip",
    "tar",
    "gz",
    "bz2",
    "xz",
    "7z"
  ],
  "interface": "cli",
  "executable": "archive.py",
  "targets": {
    "zip": [],
    "tar": [],
    "tar-gz": [
      "tar.gz"
    ],
    "tgz": [
      "tar.gz"
    ],
    "tar-bz2": [
      "tar.bz2"
    ],
    "tbz2": [
      "tar.bz2"
    ],
    "tar-xz": [
      "tar.xz"
    ],
    "txz": [
      "tar.xz"
    ],
    "gz": []
  },
  "options": [
    {
      "name": "--compression-level",
      "type": "int",
      "default": 6,
      "min": 1,
      "max": 9,
      "targets": [
        "zip",
        "gz",
        "tar-gz",
        "tgz"
      ],
      "description": "Compression level (9 = maximum)"
    }
  ],
  "dependencies": [
    {
      "name": "python3",
      "type": "system",
      "version": ">=3.8",
      "install_hint": "brew install python3 (macOS) or apt install python3 (Linux)"
    },
    {
      "name": "py7zr",
      "type": "python",
      "description": "Required for 7z archive support (optional)",
      "install_hint": "pip install py7zr"
    }
  ]
}
