{
  "name": "ascii",
  "scope": "ascii",
  "version": "1.0.5",
  "description": "Convert media to ASCII representation",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "image",
    "ascii",
    "text-art",
    "conversion"
  ],
  "interface": "cli",
  "executable": "ascii.py",
  "targets": [
    "ascii",
    "ascii-art",
    "text-art"
  ],
  "input_formats": [
    "jpg",
    "jpeg",
    "png",
    "webp",
    "bmp",
    "gif"
  ],
  "input_types": [
    "image",
    "file"
  ],
  "output_types": [
    "text"
  ],
  "options": [
    {
      "name": "--width",
      "type": "int",
      "default": "80",
      "description": "Output width in characters"
    },
    {
      "name": "--charset",
      "type": "string",
      "default": "standard",
      "description": "Character set: standard, simple, blocks, detailed"
    },
    {
      "name": "--invert",
      "type": "bool",
      "default": "false",
      "description": "Invert brightness (for dark backgrounds)"
    },
    {
      "name": "--color",
      "type": "bool",
      "default": "false",
      "description": "Output ANSI colored ASCII art"
    },
    {
      "name": "--html",
      "type": "bool",
      "default": "false",
      "description": "Output HTML with colored spans"
    }
  ],
  "dependencies": [
    {
      "name": "python3",
      "type": "system",
      "version": ">=3.8",
      "install_hint": "brew install python3 (macOS) or apt install python3 (Linux)"
    },
    {
      "name": "Pillow",
      "type": "python",
      "version": ">=9.0",
      "install_hint": "pip install Pillow"
    }
  ]
}
