{
  "name": "doc-convert",
  "scope": "uniconv",
  "version": "1.0.33",
  "description": "Convert between document formats using LibreOffice",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "document",
    "pdf",
    "docx",
    "odt",
    "xlsx",
    "pptx",
    "libreoffice",
    "hwp",
    "conversion"
  ],
  "interface": "cli",
  "bundled_bins": true,
  "executable": "doc-convert.py",
  "targets": [
    "pdf",
    "docx",
    "doc",
    "odt",
    "rtf",
    "txt",
    "html",
    "xlsx",
    "xls",
    "ods",
    "csv",
    "pptx",
    "ppt",
    "odp",
    "epub",
    "md"
  ],
  "accepts": [
    "pdf",
    "docx",
    "doc",
    "odt",
    "rtf",
    "txt",
    "html",
    "htm",
    "hwp",
    "hwpx",
    "xlsx",
    "xls",
    "ods",
    "csv",
    "pptx",
    "ppt",
    "odp",
    "epub",
    "md"
  ],
  "options": [
    {
      "name": "--pages",
      "type": "string",
      "default": "",
      "targets": [
        "pdf"
      ],
      "description": "Page range for output (e.g., '1-5', '1,3,5')"
    },
    {
      "name": "--password",
      "type": "string",
      "default": "",
      "description": "Password for protected documents"
    }
  ],
  "dependencies": [
    {
      "name": "python3",
      "type": "system",
      "version": ">=3.8",
      "install_hint": "brew install python3 (macOS) or apt install python3 (Linux)"
    },
    {
      "name": "pdf2docx",
      "type": "python",
      "version": ">=0.5.0",
      "description": "Required for PDF to DOCX conversion"
    },
    {
      "name": "pyhwp",
      "type": "python",
      "optional": true,
      "description": "Required for HWP conversion on systems where LibreOffice lacks the HWP filter",
      "install_hint": "pip install pyhwp six"
    },
    {
      "name": "six",
      "type": "python",
      "optional": true,
      "description": "Required by pyhwp (missing transitive dependency)"
    }
  ]
}
