{
  "name": "doc-convert",
  "scope": "uniconv",
  "version": "1.0.8",
  "description": "Convert between document formats using LibreOffice",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "document",
    "pdf",
    "docx",
    "odt",
    "xlsx",
    "pptx",
    "libreoffice",
    "hwp",
    "conversion"
  ],
  "interface": "cli",
  "executable": "doc-convert.py",
  "targets": [
    "pdf",
    "docx",
    "doc",
    "odt",
    "rtf",
    "txt",
    "html",
    "xlsx",
    "xls",
    "ods",
    "csv",
    "pptx",
    "ppt",
    "odp",
    "epub",
    "md"
  ],
  "input_formats": [
    "pdf",
    "docx",
    "doc",
    "odt",
    "rtf",
    "txt",
    "html",
    "htm",
    "hwp",
    "hwpx",
    "xlsx",
    "xls",
    "ods",
    "csv",
    "pptx",
    "ppt",
    "odp",
    "epub",
    "md"
  ],
  "input_types": [
    "document",
    "file"
  ],
  "output_types": [
    "document",
    "file"
  ],
  "options": [
    {
      "name": "--pages",
      "type": "string",
      "default": "",
      "description": "Page range for PDF output (e.g., '1-5', '1,3,5')"
    },
    {
      "name": "--password",
      "type": "string",
      "default": "",
      "description": "Password for protected documents"
    }
  ],
  "dependencies": [
    {
      "name": "python3",
      "type": "system",
      "version": ">=3.8",
      "install_hint": "brew install python3 (macOS) or apt install python3 (Linux)"
    },
    {
      "name": "libreoffice",
      "type": "system",
      "check": "command -v libreoffice || command -v soffice",
      "install_hint": "brew install libreoffice (macOS) or apt install libreoffice (Linux)"
    },
    {
      "name": "pandoc",
      "type": "system",
      "check": "command -v pandoc",
      "optional": true,
      "description": "Required for Markdown conversion",
      "install_hint": "brew install pandoc (macOS) or apt install pandoc (Linux)"
    },
    {
      "name": "pdf2docx",
      "type": "python",
      "version": ">=0.5.0",
      "description": "Required for PDF to DOCX conversion"
    }
  ]
}
