{
  "name": "generator",
  "scope": "uniconv",
  "version": "1.0.16",
  "description": "Generate random test data: noise images, fake names, URLs, lorem ipsum, UUIDs, passwords, and CSV",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "generator",
    "random",
    "noise",
    "faker",
    "uuid",
    "password",
    "csv",
    "lorem",
    "test-data"
  ],
  "interface": "cli",
  "executable": "generator.py",
  "accepts": [],
  "targets": {
    "random-noise": [
      "png"
    ],
    "random-names": [
      "json",
      "txt"
    ],
    "random-urls": [
      "json",
      "txt"
    ],
    "random-lorem": [
      "json",
      "txt"
    ],
    "random-uuid": [
      "json",
      "txt"
    ],
    "random-password": [
      "json",
      "txt"
    ],
    "random-csv": [
      "csv"
    ]
  },
  "options": [
    {
      "name": "--width",
      "type": "int",
      "default": 256,
      "min": 1,
      "max": 4096,
      "targets": [
        "random-noise"
      ],
      "description": "Image width in pixels"
    },
    {
      "name": "--height",
      "type": "int",
      "default": 256,
      "min": 1,
      "max": 4096,
      "targets": [
        "random-noise"
      ],
      "description": "Image height in pixels"
    },
    {
      "name": "--count",
      "type": "int",
      "default": 10,
      "min": 1,
      "max": 1000,
      "targets": [
        "random-names",
        "random-urls",
        "random-uuid",
        "random-password"
      ],
      "description": "Number of items to generate"
    },
    {
      "name": "--length",
      "type": "int",
      "default": 16,
      "min": 4,
      "max": 128,
      "targets": [
        "random-password"
      ],
      "description": "Password length in characters"
    },
    {
      "name": "--paragraphs",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 50,
      "targets": [
        "random-lorem"
      ],
      "description": "Number of paragraphs"
    },
    {
      "name": "--rows",
      "type": "int",
      "default": 100,
      "min": 1,
      "max": 10000,
      "targets": [
        "random-csv"
      ],
      "description": "Number of rows"
    },
    {
      "name": "--columns",
      "type": "string",
      "default": "name,email,phone,address",
      "targets": [
        "random-csv"
      ],
      "description": "Comma-separated column types (name, email, phone, address, company, date, city, country, job, text, url, uuid, number, boolean)"
    },
    {
      "name": "--format",
      "type": "string",
      "default": "json",
      "choices": [
        "json",
        "txt"
      ],
      "targets": [
        "random-names",
        "random-urls",
        "random-lorem",
        "random-uuid",
        "random-password"
      ],
      "description": "Output format"
    },
    {
      "name": "--locale",
      "type": "string",
      "default": "en_US",
      "choices": [
        "en_US",
        "ko_KR",
        "ja_JP",
        "zh_CN",
        "de_DE",
        "fr_FR",
        "es_ES"
      ],
      "targets": [
        "random-names",
        "random-urls",
        "random-lorem",
        "random-csv"
      ],
      "description": "Locale for data generation"
    },
    {
      "name": "--seed",
      "type": "int",
      "required": false,
      "description": "Random seed for reproducible output"
    }
  ],
  "dependencies": [
    {
      "name": "python3",
      "type": "system",
      "version": ">=3.8",
      "install_hint": "brew install python3 (macOS) or apt install python3 (Linux)"
    },
    {
      "name": "Pillow",
      "type": "python",
      "description": "Required for random-noise image generation",
      "install_hint": "pip install Pillow"
    },
    {
      "name": "faker",
      "type": "python",
      "description": "Required for generating fake data (names, URLs, lorem, CSV)",
      "install_hint": "pip install faker"
    }
  ]
}
