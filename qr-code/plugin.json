{
  "name": "qr-code",
  "scope": "uniconv",
  "version": "1.0.19",
  "description": "Generate and decode QR codes",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "qr",
    "qr-code",
    "barcode",
    "qrcode",
    "encode",
    "decode"
  ],
  "interface": "cli",
  "executable": "qr-code.py",
  "bundled_libs": [
    {
      "pkg_config": "zbar",
      "lib_name": "zbar"
    }
  ],
  "targets": {
    "qr": [
      "png"
    ],
    "qr-decode": [
      "txt"
    ]
  },
  "accepts": [
    "txt",
    "png",
    "jpg",
    "jpeg"
  ],
  "options": [
    {
      "name": "--scale",
      "type": "int",
      "default": 10,
      "min": 1,
      "max": 50,
      "targets": [
        "qr"
      ],
      "description": "Pixels per module"
    },
    {
      "name": "--border",
      "type": "int",
      "default": 4,
      "min": 0,
      "max": 20,
      "targets": [
        "qr"
      ],
      "description": "Quiet zone border in modules"
    },
    {
      "name": "--error",
      "type": "string",
      "default": "M",
      "choices": [
        "L",
        "M",
        "Q",
        "H"
      ],
      "targets": [
        "qr"
      ],
      "description": "Error correction: L (7%), M (15%), Q (25%), H (30%)"
    }
  ],
  "dependencies": [
    {
      "name": "python3",
      "type": "system",
      "version": ">=3.8",
      "install_hint": "brew install python3 (macOS) or apt install python3 (Linux)"
    },
    {
      "name": "segno",
      "type": "python",
      "description": "Required for QR code generation",
      "install_hint": "pip install segno"
    },
    {
      "name": "Pillow",
      "type": "python",
      "description": "Required for QR code decoding",
      "install_hint": "pip install Pillow"
    },
    {
      "name": "pyzbar",
      "type": "python",
      "description": "Required for QR code decoding",
      "install_hint": "pip install pyzbar"
    }
  ],
  "target_input_formats": {
    "qr": [
      "txt"
    ],
    "qr-decode": [
      "png",
      "jpg",
      "jpeg"
    ]
  }
}
