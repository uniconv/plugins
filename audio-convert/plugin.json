{
  "name": "audio-convert",
  "scope": "uniconv",
  "version": "1.1.23",
  "description": "Audio format conversion and audio extraction from video (mp3, wav, flac, aac, ogg, opus, m4a, wma, aiff, alac, ac3)",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "audio",
    "music",
    "sound",
    "conversion",
    "ffmpeg"
  ],
  "interface": "native",
  "library": "libaudio_convert",
  "targets": [
    "mp3",
    "wav",
    "flac",
    "aac",
    "ogg",
    "opus",
    "m4a",
    "wma",
    "aiff",
    "alac",
    "ac3"
  ],
  "accepts": [
    "mp3",
    "wav",
    "flac",
    "aac",
    "ogg",
    "opus",
    "m4a",
    "wma",
    "aiff",
    "alac",
    "ac3",
    "amr",
    "ape",
    "mp4",
    "mov",
    "avi",
    "webm",
    "mkv",
    "m4v"
  ],
  "options": [
    {
      "name": "--bitrate",
      "type": "string",
      "default": "128k",
      "choices": [
        "64k",
        "128k",
        "192k",
        "256k",
        "320k"
      ],
      "description": "Output bitrate"
    },
    {
      "name": "--sample-rate",
      "type": "int",
      "required": false,
      "choices": [
        "8000",
        "22050",
        "44100",
        "48000",
        "96000"
      ],
      "description": "Output sample rate in Hz"
    },
    {
      "name": "--channels",
      "type": "int",
      "required": false,
      "min": 1,
      "max": 2,
      "description": "Output channels (1 = mono, 2 = stereo)"
    },
    {
      "name": "--volume",
      "type": "float",
      "default": "1.0",
      "min": 0.0,
      "max": 5.0,
      "description": "Volume adjustment (0.5 = half, 2.0 = double)"
    },
    {
      "name": "--start",
      "type": "float",
      "required": false,
      "min": 0.0,
      "description": "Start time in seconds"
    },
    {
      "name": "--duration",
      "type": "float",
      "required": false,
      "min": 0.0,
      "description": "Duration in seconds"
    }
  ]
}
