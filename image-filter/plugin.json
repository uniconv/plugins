{
  "name": "image-filter",
  "scope": "uniconv",
  "version": "1.0.12",
  "description": "Apply image filters (grayscale, invert) using Python/Pillow",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "image",
    "grayscale",
    "invert",
    "filter",
    "conversion"
  ],
  "interface": "cli",
  "executable": "image_filter.py",
  "targets": [
    "grayscale",
    "invert"
  ],
  "input_formats": [
    "jpg",
    "jpeg",
    "png",
    "webp",
    "bmp",
    "gif"
  ],
  "input_types": [
    "image",
    "file"
  ],
  "output_types": [
    "image"
  ],
  "options": [
    {
      "name": "--quality",
      "type": "int",
      "default": 85,
      "min": 1,
      "max": 100,
      "description": "Output image quality"
    },
    {
      "name": "--width",
      "type": "int",
      "min": 1,
      "description": "Output width in pixels"
    },
    {
      "name": "--height",
      "type": "int",
      "min": 1,
      "description": "Output height in pixels"
    },
    {
      "name": "--method",
      "type": "string",
      "default": "luminosity",
      "choices": [
        "luminosity",
        "average",
        "lightness"
      ],
      "targets": [
        "grayscale"
      ],
      "description": "Grayscale conversion method"
    }
  ],
  "dependencies": [
    {
      "name": "python3",
      "type": "system",
      "version": ">=3.8",
      "install_hint": "brew install python3 (macOS) or apt install python3 (Linux)"
    },
    {
      "name": "Pillow",
      "type": "python",
      "version": ">=9.0",
      "install_hint": "pip install Pillow"
    }
  ]
}
