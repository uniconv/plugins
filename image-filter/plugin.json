{
  "name": "image-filter",
  "scope": "uniconv",
  "version": "1.0.23",
  "description": "Apply image filters (grayscale, invert, rembg) using Python/Pillow",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "image",
    "grayscale",
    "invert",
    "rembg",
    "filter",
    "conversion"
  ],
  "interface": "cli",
  "executable": "image_filter.py",
  "targets": {
    "grayscale": [
      "png",
      "jpg",
      "webp"
    ],
    "invert": [
      "png",
      "jpg",
      "webp"
    ],
    "rembg": [
      "png"
    ]
  },
  "accepts": [
    "jpg",
    "jpeg",
    "png",
    "webp",
    "bmp",
    "gif"
  ],
  "options": [
    {
      "name": "--quality",
      "type": "int",
      "default": 85,
      "min": 1,
      "max": 100,
      "description": "Output image quality"
    },
    {
      "name": "--width",
      "type": "int",
      "required": false,
      "min": 1,
      "description": "Output width in pixels"
    },
    {
      "name": "--height",
      "type": "int",
      "required": false,
      "min": 1,
      "description": "Output height in pixels"
    },
    {
      "name": "--method",
      "type": "string",
      "default": "luminosity",
      "choices": [
        "luminosity",
        "average",
        "lightness"
      ],
      "targets": [
        "grayscale"
      ],
      "description": "Grayscale conversion method"
    },
    {
      "name": "--model",
      "type": "string",
      "default": "u2net",
      "choices": [
        "u2net",
        "u2netp",
        "u2net_human_seg",
        "isnet-general-use",
        "isnet-anime",
        "birefnet-general",
        "silueta"
      ],
      "targets": [
        "rembg"
      ],
      "description": "Background removal model"
    }
  ],
  "dependencies": [
    {
      "name": "python3",
      "type": "system",
      "version": ">=3.8",
      "install_hint": "brew install python3 (macOS) or apt install python3 (Linux)"
    },
    {
      "name": "Pillow",
      "type": "python",
      "version": ">=9.0",
      "install_hint": "pip install Pillow"
    },
    {
      "name": "rembg[cpu]",
      "type": "python",
      "install_hint": "pip install \"rembg[cpu]\""
    }
  ]
}
