{
  "name": "image-convert",
  "scope": "uniconv",
  "version": "1.0.45",
  "description": "Image format conversion using libvips",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "image",
    "vips",
    "jpg",
    "png",
    "webp",
    "heic",
    "conversion"
  ],
  "interface": "native",
  "library": "libimage_convert",
  "targets": [
    "jpg",
    "jpeg",
    "png",
    "webp",
    "gif",
    "bmp",
    "tiff",
    "heic",
    "heif",
    "pdf"
  ],
  "accepts": [
    "heic",
    "heif",
    "jpg",
    "jpeg",
    "png",
    "webp",
    "gif",
    "bmp",
    "tiff",
    "pdf"
  ],
  "options": [
    {
      "name": "--quality",
      "short": "-q",
      "type": "int",
      "min": 1,
      "max": 100,
      "default": 85,
      "description": "Output image quality"
    },
    {
      "name": "--width",
      "short": "-w",
      "type": "int",
      "required": false,
      "min": 1,
      "description": "Output width in pixels (aspect ratio preserved)"
    },
    {
      "name": "--height",
      "short": "-h",
      "type": "int",
      "required": false,
      "min": 1,
      "description": "Output height in pixels (aspect ratio preserved)"
    }
  ]
}
