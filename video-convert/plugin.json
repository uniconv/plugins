{
  "name": "video-convert",
  "scope": "uniconv",
  "version": "1.1.17",
  "description": "Bidirectional video format conversion (mp4, mov, avi, webm, mkv, m4v, gif)",
  "author": "uniconv",
  "license": "MIT",
  "repository": "https://github.com/uniconv/plugins",
  "keywords": [
    "video",
    "gif",
    "animation",
    "conversion",
    "ffmpeg"
  ],
  "interface": "native",
  "library": "libvideo_convert",
  "targets": [
    "mp4",
    "mov",
    "avi",
    "webm",
    "mkv",
    "m4v",
    "gif"
  ],
  "input_formats": [
    "mp4",
    "mov",
    "avi",
    "webm",
    "mkv",
    "m4v",
    "gif"
  ],
  "input_types": [
    "video",
    "file"
  ],
  "output_types": [
    "video",
    "image"
  ],
  "options": [
    {
      "name": "--fps",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 120,
      "description": "Frames per second (0 = keep original)"
    },
    {
      "name": "--width",
      "type": "int",
      "min": 1,
      "description": "Output width in pixels (aspect ratio preserved)"
    },
    {
      "name": "--height",
      "type": "int",
      "min": 1,
      "description": "Output height in pixels (aspect ratio preserved)"
    },
    {
      "name": "--quality",
      "type": "int",
      "default": 75,
      "min": 1,
      "max": 100,
      "description": "Output quality"
    },
    {
      "name": "--start",
      "type": "float",
      "min": 0.0,
      "description": "Start time in seconds"
    },
    {
      "name": "--duration",
      "type": "float",
      "min": 0.0,
      "description": "Duration in seconds"
    },
    {
      "name": "--loop",
      "type": "int",
      "default": 0,
      "min": 0,
      "targets": [
        "gif"
      ],
      "description": "Loop count (0 = infinite)"
    }
  ]
}
