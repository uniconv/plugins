{
  "name": "video-convert",
  "scope": "video-convert",
  "version": "1.1.4",
  "description": "Bidirectional video format conversion (mp4, mov, avi, webm, mkv, m4v, gif)",
  "iface": "native",
  "library": "libvideo_convert",
  "targets": [
    "mp4",
    "mov",
    "avi",
    "webm",
    "mkv",
    "m4v",
    "gif"
  ],
  "input_formats": [
    "mp4",
    "mov",
    "avi",
    "webm",
    "mkv",
    "m4v",
    "gif"
  ],
  "input_types": [
    "video",
    "file"
  ],
  "output_types": [
    "video",
    "image"
  ],
  "options": [
    {
      "name": "--fps",
      "type": "int",
      "default": "0",
      "description": "Output frames per second (0 = keep original; default 10 for GIF)"
    },
    {
      "name": "--width",
      "type": "int",
      "description": "Output width in pixels (height auto-scaled to preserve aspect ratio)"
    },
    {
      "name": "--height",
      "type": "int",
      "description": "Output height in pixels (width auto-scaled to preserve aspect ratio)"
    },
    {
      "name": "--quality",
      "type": "int",
      "default": "75",
      "description": "Output quality (1-100, higher is better)"
    },
    {
      "name": "--start",
      "type": "float",
      "description": "Start time in seconds"
    },
    {
      "name": "--duration",
      "type": "float",
      "description": "Duration in seconds"
    },
    {
      "name": "--loop",
      "type": "int",
      "default": "0",
      "description": "Number of loops for GIF (0 = infinite)"
    }
  ],
  "dependencies": [
    {
      "name": "libavformat-dev",
      "type": "system",
      "check": "pkg-config --exists libavformat"
    },
    {
      "name": "libavcodec-dev",
      "type": "system",
      "check": "pkg-config --exists libavcodec"
    },
    {
      "name": "libavutil-dev",
      "type": "system",
      "check": "pkg-config --exists libavutil"
    },
    {
      "name": "libswscale-dev",
      "type": "system",
      "check": "pkg-config --exists libswscale"
    },
    {
      "name": "libavfilter-dev",
      "type": "system",
      "check": "pkg-config --exists libavfilter"
    }
  ]
}
